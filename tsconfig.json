{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,

    "allowJs": true,
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // `downstream/check.ts` is the runner for the downstream-contract typecheck and
  // is checked here. `downstream/src/**` is deliberately NOT included: those files
  // must only ever be compiled by downstream/tsconfig*.json, which has no `~/*`
  // paths alias — resolving them through this config would defeat the fixture.
  "include": [
    "src/**/*",
    "tests/**/*",
    "eslint.config.js",
    "tsup.config.ts",
    "downstream/check.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
